  "scene_actions": [
    {
      "key": "add_card",
      "label": {
        "en": "Add a Planka card",
        "fr": "Ajouter une carte Planka",
        "de": "Planka-Karte hinzufügen",
        "es": "Añadir una tarjeta de Planka"
      },
      "description": {
        "en": "Adds a card at the bottom of a list, as the configured user.",
        "fr": "Ajoute une carte en bas d'une liste, au nom de l'utilisateur configuré.",
        "de": "Fügt eine Karte unten in einer Liste hinzu, als konfigurierter Benutzer.",
        "es": "Añade una tarjeta al final de una lista, como el usuario configurado."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "title",
          "type": "string",
          "required": true,
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "board",
          "type": "string",
          "label": {
            "en": "Board name (empty: the first one)",
            "fr": "Nom du tableau (vide : le premier)",
