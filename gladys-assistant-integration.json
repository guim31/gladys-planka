{
  "manifest_version": 1,
  "type": "device",
  "name": "Planka",
  "description": {
    "en": "Planka kanban boards: cards due today and overdue, moves, cards added or moved from a scene.",
    "fr": "Tableaux kanban Planka : cartes du jour et en retard, déplacements, ajout de cartes par scène.",
    "de": "Planka-Kanban-Boards: heute fällige und überfällige Karten, Verschiebungen, Karten aus Szenen.",
    "es": "Tableros kanban de Planka: tarjetas de hoy y atrasadas, movimientos, tarjetas desde una escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-planka:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-planka/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Planka",
        "fr": "Votre Planka",
        "de": "Dein Planka",
        "es": "Su Planka"
      },
      "description": {
        "en": "A self-hosted Planka 2. Give an API key (created by an administrator), or the username and password of a user who logged in once in the web app.",
        "fr": "Un Planka 2 auto-hébergé. Donnez une clé d'API (créée par un administrateur), ou l'identifiant et le mot de passe d'un utilisateur déjà connecté une fois à l'interface.",
        "de": "Ein selbst gehostetes Planka 2. Gib einen API-Schlüssel (von einem Administrator erstellt) oder Benutzername und Passwort eines Benutzers an, der sich einmal in der Weboberfläche angemeldet hat.",
        "es": "Un Planka 2 autoalojado. Indique una clave de API (creada por un administrador), o el usuario y la contraseña de un usuario que ya haya iniciado sesión una vez en la interfaz web."
      },
      "links": [
        {
          "url": "https://docs.planka.cloud/",
          "label": {
            "en": "Planka documentation",
            "fr": "Documentation de Planka",
            "de": "Planka-Dokumentation",
            "es": "Documentación de Planka"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "Address of Planka, as in the browser, with https:// for HTTPS and :port if not the default.",
        "fr": "Adresse de Planka, comme dans le navigateur, avec https:// pour le HTTPS et :port s'il n'est pas celui par défaut.",
        "de": "Adresse von Planka wie im Browser, mit https:// für HTTPS und :Port, falls nicht der Standard.",
        "es": "Dirección de Planka, como en el navegador, con https:// para HTTPS y :puerto si no es el predeterminado."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20:3000",
        "fr": "ex. http://192.168.1.20:3000",
        "de": "z. B. http://192.168.1.20:3000",
        "es": "p. ej. http://192.168.1.20:3000"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d'API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "Recommended. Administration, Users, the user's menu, API key. Empty: the username and password below are used.",
        "fr": "Recommandé. Administration, Utilisateurs, menu de l'utilisateur, clé d'API. Vide : l'identifiant et le mot de passe ci-dessous servent.",
        "de": "Empfohlen. Administration, Benutzer, Menü des Benutzers, API-Schlüssel. Leer: Benutzername und Passwort unten werden verwendet.",
        "es": "Recomendado. Administración, Usuarios, menú del usuario, clave de API. Vacío: se usan el usuario y la contraseña de abajo."
      },
      "required": false
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username or e-mail",
        "fr": "Identifiant ou e-mail",
        "de": "Benutzername oder E-Mail",
        "es": "Usuario o correo electrónico"
      },
      "description": {
        "en": "Without an API key: a Planka user without two-factor login.",
        "fr": "Sans clé d'API : un utilisateur de Planka sans connexion à deux facteurs.",
        "de": "Ohne API-Schlüssel: ein Planka-Benutzer ohne Zwei-Faktor-Anmeldung.",
        "es": "Sin clave de API: un usuario de Planka sin inicio de sesión de dos factores."
      },
      "required": false,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": false
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "boards",
      "type": "string",
      "label": {
        "en": "Followed boards",
        "fr": "Tableaux suivis",
        "de": "Verfolgte Boards",
        "es": "Tableros seguidos"
      },
      "description": {
        "en": "Names separated by commas. Empty: every board of the user (20 at most). One device per followed board.",
        "fr": "Noms séparés par des virgules. Vide : tous les tableaux de l'utilisateur (20 au plus). Un appareil par tableau suivi.",
        "de": "Namen durch Kommas getrennt. Leer: alle Boards des Benutzers (höchstens 20). Ein Gerät pro verfolgtem Board.",
        "es": "Nombres separados por comas. Vacío: todos los tableros del usuario (20 como máximo). Un dispositivo por tablero seguido."
      },
      "placeholder": {
        "en": "e.g. Home, Shopping",
        "fr": "ex. Maison, Courses",
        "de": "z. B. Haushalt, Einkauf",
        "es": "p. ej. Casa, Compras"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "For an https:// address whose certificate is self-signed. Tick only for your own server.",
        "fr": "Pour une adresse en https:// dont le certificat est auto-signé. À cocher seulement pour votre propre serveur.",
        "de": "Für eine https://-Adresse mit selbstsigniertem Zertifikat. Nur für deinen eigenen Server aktivieren.",
        "es": "Para una dirección https:// con certificado autofirmado. Márquelo solo para su propio servidor."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Planka is read (one request per board). Due dates and midnight are always followed on time.",
        "fr": "Fréquence de lecture de Planka (une requête par tableau). Les échéances et minuit sont toujours suivis à l'heure.",
        "de": "Wie oft Planka gelesen wird (eine Anfrage pro Board). Fälligkeiten und Mitternacht werden immer pünktlich verfolgt.",
        "es": "Frecuencia de lectura de Planka (una solicitud por tablero). Los vencimientos y la medianoche se siguen siempre a tiempo."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when a device is added, and texts sent to scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'un appareil, et textes envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen eines Geräts und an Szenen gesendete Texte.",
        "es": "Nombres dados a las funciones al añadir un dispositivo y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads Planka now and reports what it finds.",
        "fr": "Lit Planka maintenant et indique ce qu'elle trouve.",
        "de": "Liest Planka jetzt und meldet, was gefunden wurde.",
        "es": "Lee Planka ahora e informa de lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "card_moved",
      "label": {
        "en": "Planka card moved",
        "fr": "Carte Planka déplacée",
        "de": "Planka-Karte verschoben",
        "es": "Tarjeta de Planka movida"
      },
      "description": {
        "en": "A card arrived in another list of its board.",
        "fr": "Une carte est arrivée dans une autre liste de son tableau.",
        "de": "Eine Karte ist in einer anderen Liste ihres Boards angekommen.",
        "es": "Una tarjeta llegó a otra lista de su tablero."
      },
      "fields": [
        {
          "key": "board",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Board (empty: any)",
            "fr": "Tableau (vide : tous)",
            "de": "Board (leer: alle)",
            "es": "Tablero (vacío: cualquiera)"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List name (empty: any)",
            "fr": "Nom de la liste (vide : toutes)",
            "de": "Listenname (leer: alle)",
            "es": "Nombre de la lista (vacío: cualquiera)"
          },
          "description": {
            "en": "Exactly as written in Planka, e.g. Done.",
            "fr": "Exactement comme dans Planka, ex. Fait.",
            "de": "Genau wie in Planka, z. B. Erledigt.",
            "es": "Exactamente como en Planka, p. ej. Hecho."
          }
        }
      ],
      "variables": [
        {
          "key": "card",
          "type": "string",
          "label": {
            "en": "Card",
            "fr": "Carte",
            "de": "Karte",
            "es": "Tarjeta"
          }
        },
        {
          "key": "card_id",
          "type": "string",
          "label": {
            "en": "Card id",
            "fr": "Numéro de la carte",
            "de": "Karten-ID",
            "es": "Número de la tarjeta"
          }
        },
        {
          "key": "board_name",
          "type": "string",
          "label": {
            "en": "Board",
            "fr": "Tableau",
            "de": "Board",
            "es": "Tablero"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List",
            "fr": "Liste",
            "de": "Liste",
            "es": "Lista"
          }
        },
        {
          "key": "previous_list",
          "type": "string",
          "label": {
            "en": "Previous list",
            "fr": "Liste précédente",
