    {
      "key": "move_card",
      "label": {
        "en": "Move a Planka card",
        "fr": "Déplacer une carte Planka",
        "de": "Planka-Karte verschieben",
        "es": "Mover una tarjeta de Planka"
      },
      "description": {
        "en": "Moves a card of a followed board to the bottom of another list.",
        "fr": "Déplace une carte d'un tableau suivi en bas d'une autre liste.",
        "de": "Verschiebt eine Karte eines verfolgten Boards ans Ende einer anderen Liste.",
        "es": "Mueve una tarjeta de un tablero seguido al final de otra lista."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "card",
          "type": "string",
          "required": true,
          "label": {
            "en": "Card name or id",
            "fr": "Nom ou numéro de la carte",
            "de": "Kartenname oder ID",
            "es": "Nombre o número de la tarjeta"
          },
          "description": {
